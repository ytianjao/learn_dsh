{
  "name": "@learnloop/dsh-learnloop",
  "version": "0.1.0",
  "description": "Local-first long-term learning companion for DeepSeek Harness Web",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client",
    "profiles",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run tests/domain.spec.ts",
    "test:integration": "vitest run tests/http.spec.ts",
    "test:compat": "vitest run tests/compatibility.spec.ts",
    "test:health": "python -m pytest tests/test_health.py",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && node --check client/bundle.js && npm test && npm run test:health",
    "package:validate": "npm pack --dry-run",
    "prepare": "pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.8",
    "@deepseek-ai/dsh-storage-domain": "0.0.1-rc.1"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.8",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.8",
    "@deepseek-ai/dsh-storage-domain": "0.0.1-rc.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  }
}
