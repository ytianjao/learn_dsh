{
  "name": "@learnloop/dsh-learnloop",
  "version": "0.11.0",
  "description": "Local-first long-term learning companion for DeepSeek Harness Web",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client",
    "profiles",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run tests/domain.spec.ts",
    "test:integration": "vitest run tests/http.spec.ts",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "acceptance:prepare": "bash scripts/cloud-acceptance-prepare.sh",
    "acceptance:web": "bash scripts/cloud-acceptance-web.sh",
    "acceptance:test": "node ./node_modules/@playwright/test/cli.js test",
    "e2e:keyless:web": "node scripts/keyless-web-e2e.mjs",
    "acceptance:reset": "bash scripts/cloud-acceptance-reset.sh",
    "check": "pnpm run typecheck && node --check client/bundle.js && pnpm test",
    "package:validate": "npm pack --dry-run",
    "prepare": "pnpm run build",
    "test:evidence": "vitest run tests/evidence-bridge.spec.ts",
    "test:assessment": "vitest run tests/assessment-tool.spec.ts",
    "test:prompt": "vitest run tests/prompt.spec.ts",
    "test:runtime": "vitest run tests/assessment-tool.spec.ts tests/evidence-bridge.spec.ts tests/prompt.spec.ts",
    "test:upstream-contract": "vitest run tests/upstream-contract.spec.ts",
    "verify:dsh-baseline": "node scripts/verify-dsh-baseline.mjs",
    "verify:article-export": "node scripts/generate-article-export-fixture.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.1-rc.2"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "playwright-core": "^1.62.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.1-rc.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  }
}
